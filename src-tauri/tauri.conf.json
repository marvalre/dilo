{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dicta",
  "version": "0.1.0",
  "identifier": "com.dicta.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0", "infoPlist": "Info.plist" }
  }
}
